# Personal data. Never commit any of this.
#
# Note the trailing /* rather than /. Git does not descend into an excluded
# directory, so "profile/" would make the negations below unreachable and the
# example files would never be committed.
profile/*
data/*
.env

# Templates that are safe to publish.
!profile/*.example.yaml
!profile/*.example.md
!profile/README.md
!data/.gitkeep

# Timestamped backups a script wrote next to the original
*.bak-*
*.pre-*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# macOS
.DS_Store

# Editor
.vscode/
.idea/

# LaTeX resume sources, personal
latex/*
!latex/README.md

# Second git dir tracking profile/, data/ and latex/ into a PRIVATE repo.
# See scripts/backup.sh. Never let this land in the public history.
.git-private/
